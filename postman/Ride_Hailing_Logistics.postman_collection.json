    {
      "name": "04. Dynamic Fare Estimation & Quote (Pricing Service)",
      "description": "Tính toán giá cước tự động dựa trên công thức Haversine, hệ số đường phố 1.3 và khóa báo giá trong 10 phút.",
      "item": [
        {
          "name": "4.1 Estimate Fare & Create Quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if ((jsonData.data) && (jsonData.code === 'SUCCESS' || jsonData.success !== false)) {",
                  "    pm.environment.set(\"quote_id\", jsonData.data.quoteId);",
                  "    console.log(\"Saved new quote_id: \" + jsonData.data.quoteId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceType\": \"RIDE\",\n  \"regionCode\": \"VN-HN\",\n  \"pickupAddress\": \"Nhà hát Lớn Hà Nội, Hoàn Kiếm\",\n  \"pickupLat\": 21.028511,\n  \"pickupLng\": 105.854444,\n  \"dropoffAddress\": \"Đại học Bách Khoa Hà Nội, Hai Bà Trưng\",\n  \"dropoffLat\": 21.004444,\n  \"dropoffLng\": 105.843333\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pricing/quotes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "pricing",
                "quotes"
              ]
            }
          }
        },
        {
          "name": "4.2 Get Quote Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/pricing/quotes/{{quote_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "pricing",
                "quotes",
                "{{quote_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05. Trip Lifecycle & Concurrency (Trip Service)",
      "description": "Khách đặt xe (tiêu thụ báo giá), tài xế nhận cuốc (phòng thủ Concurrency), chuyển đổi trạng thái FSM và hoàn thành chuyến.",
      "item": [
        {
          "name": "5.1 Customer Create Trip (Book Ride)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if ((jsonData.data) && (jsonData.code === 'SUCCESS' || jsonData.success !== false)) {",
                  "    var tripId = jsonData.data.tripId || jsonData.data.id;",
                  "    pm.environment.set(\"trip_id\", tripId);",
                  "    console.log(\"Saved trip_id: \" + tripId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uuid = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.environment.set(\"idempotency_key\", uuid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quote_id}}\",\n  \"idempotencyKey\": \"{{idempotency_key}}\",\n  \"paymentMethod\": \"CASH\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/trips",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "trips"
              ]
            }
          }
        },
        {
          "name": "5.1.1 Driver Get Pending Offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set(\"offer_id\", jsonData.data[0].offerId);",
                  "    console.log(\"Auto-assigned offer_id: \" + jsonData.data[0].offerId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/trips/offers/pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "offers",
                "pending"
              ]
            }
          }
        },
        {
          "name": "5.2 Driver Respond to Offer (Accept Trip)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/trips/offers/{{offer_id}}/respond",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "offers",
                "{{offer_id}}",
                "respond"
              ]
            }
          }
        },
        {
          "name": "5.3 Driver Update Status to PICKING_UP",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/trips/{{trip_id}}/status?nextStatus=PICKING_UP",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "{{trip_id}}",
                "status"
              ],
              "query": [
                {
                  "key": "nextStatus",
                  "value": "PICKING_UP"
                }
              ]
            }
          }
        },
        {
          "name": "5.4 Driver Update Status to ARRIVED",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/trips/{{trip_id}}/status?nextStatus=ARRIVED",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "{{trip_id}}",
                "status"
              ],
