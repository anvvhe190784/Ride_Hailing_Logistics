          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"customer_token\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
