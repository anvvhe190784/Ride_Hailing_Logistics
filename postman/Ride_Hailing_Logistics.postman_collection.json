    {
      "name": "03. Realtime Location & Redis GEO (Location Service)",
      "description": "Cập nhật tọa độ GPS thiết bị tài xế và truy vấn tài xế lân cận bằng Redis GEO.",
      "item": [
        {
          "name": "3.1 Driver Update GPS Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 21.028511,\n  \"longitude\": 105.854444,\n  \"speedMps\": 8.5,\n  \"headingDegrees\": 45.0,\n  \"accuracyMeters\": 3.5,\n  \"sequenceNum\": 1,\n  \"deviceTimestamp\": \"2026-10-27T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/locations/telemetry",
              "host": [
