{
  "info": {
    "_postman_id": "b8f6e2a1-3c5d-4f9e-a812-7890abcdef12",
    "name": "Ride-Hailing & Logistics Platform (Thesis Defense 21 UCs)",
    "description": "Postman Collection hoàn chỉnh cho 21 Use Cases của hệ thống Microservices Ride-Hailing & Logistics.\nTích hợp sẵn script tự động lưu Token, ID cho các luồng nghiệp vụ liên hoàn từ Đăng nhập, Duyệt hồ sơ, Cập nhật GPS, Tính cước, Đặt xe, Nhận cuốc đến Quyết toán ví.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Authentication & Security (IAM)",
      "description": "Các Use Case liên quan đến đăng ký, đăng nhập theo từng Role, cấp Access/Refresh Token và thu hồi Token (Blacklist).",
      "item": [
        {
          "name": "1.1 Register New Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{new_customer_phone}}\",\n  \"email\": \"newbie.customer@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Trần Thị Khách Mới\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomPhone = \"098\" + Math.floor(1000000 + Math.random() * 9000000);",
                  "pm.environment.set(\"new_customer_phone\", randomPhone);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if ((jsonData.data) && (jsonData.code === 'SUCCESS' || jsonData.success !== false)) {",
                  "    pm.environment.set(\"customer_token\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "    if (jsonData.data.user) {",
                  "        pm.environment.set(\"customer_id\", jsonData.data.user.id);",
                  "    }",
                  "    console.log(\"Saved customer_token: \" + jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{customer_phone}}\",\n  \"password\": \"{{customer_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
