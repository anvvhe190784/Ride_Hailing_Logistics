    {
      "name": "02. Driver Operations & KYC (Driver Service)",
      "description": "Quản lý vòng đời tài xế, nộp hồ sơ, Admin phê duyệt hồ sơ KYC, và cập nhật trạng thái hoạt động.",
      "item": [
        {
          "name": "2.1 Get My Driver Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/drivers/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "drivers",
                "me"
              ]
            }
          }
        },
        {
          "name": "2.2 Admin Approve Driver KYC",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
